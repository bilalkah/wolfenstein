    "campaign": {
        "opening": [
            {
                "title": "THE NUMBERS",
                "text": "For three weeks nothing has come out of the Kessel Valley but numbers. Every hour, on every band, the transmitter at Castle Wolfenstein sends eleven digits and then falls silent. The garrison posts along the valley road stopped answering the day the numbers began."
            },
            {
                "title": "THE TEAMS",
                "text": "Two teams went in to find out why. Neither came back. The last message from the second was three words long: they are not dead. Whatever it meant, nobody has heard from the valley since."
            },
            {
                "title": "YOU",
                "text": "You go in alone, on foot, by the old road. Find out what became of the garrison. Find the source of the numbers. And if the castle is doing what the analysts fear, stop it. Nobody is coming after you."
            }
        ],
        "chapters": [
            {
                "title": "CHAPTER I",
                "name": "THE VALLEY",
                "text": "The road climbs from the checkpoint past the depot and the barracks, over the ridge where the relay stands, and down into the catacombs. Somewhere along it, the garrison stopped being a garrison.",
                "levels": [
                    "level1.json",
                    "depot.json",
                    "level2.json",
                    "radio_station.json",
                    "level3.json"
                ]
            },
            {
                "title": "CHAPTER II",
                "name": "THE WORKS",
                "text": "Under the valley the Directorate dug a works: a mine, a forge, laboratories, archives and a railway up the mountain. Whatever was made down here went up to the castle by night.",
                "levels": [
                    "mine.json",
                    "level4.json",
                    "laboratory.json",
                    "level5.json",
                    "rail_yard.json"
                ]
            },
            {
                "title": "CHAPTER III",
                "name": "THE CASTLE",
                "text": "Castle Wolfenstein. The numbers were a count, and it is nearly done. Over the wall, under it and up through the keep to the bell tower: at the end of the count, something in the sanctum opens.",
                "levels": [
                    "outer_wall.json",
                    "dungeons.json",
                    "level6.json",
                    "bell_tower.json",
                    "level7.json"
                ]
            }
        ],
        "ending": [
            {
                "title": "THE GATE",
                "text": "The last of its guardians falls, and the ring of stones in the sanctum goes dark. The mountain shudders once, the way a door does when it is slammed from the other side."
            },
            {
                "title": "THE SILENCE",
                "text": "At dawn the transmitter at Castle Wolfenstein sends nothing at all. Down the valley, in the barracks and the works, the soldiers who were not dead lie down at last."
            },
            {
                "title": "AFTERWARD",
                "text": "The analysts will argue for years about what waited on the other side of the gate. You were there, and you do not argue. You keep the last page of the archivist's ledger in your coat: a second column of numbers, in another hand, still counting."
            }
        ]
    }
}
